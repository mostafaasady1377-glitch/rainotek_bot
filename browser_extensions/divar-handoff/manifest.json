{
  "manifest_version": 3,
  "name": "RAINOTEK Divar Handoff",
  "version": "0.3.0",
  "description": "Import an approved RAINOTEK draft into your own Divar browser. No payment or publication.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1:8769/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://divar.ir/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
