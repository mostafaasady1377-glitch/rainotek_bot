# ==========================================
# تنظیمات تلگرام ربات فروشگاه راینوتک (Rhinotech)
# ==========================================
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken
BOT_USERNAME=rainotek_bot

# شناسه‌های عددی تلگرام مدیران کل (با کاما جدا شوند)
ADMIN_TELEGRAM_IDS=123456789,987654321

# ربات مدیریتی مستقل بخش هوش مصنوعی (فقط مالک، بدون دسترسی ادمین فروشگاه)
AI_ADMIN_BOT_TOKEN=
AI_OWNER_TELEGRAM_ID=0
VPN_PAYMENT_CARD=
VPN_PAYMENT_HOLDER=
# در شبکه‌هایی که اتصال مستقیم تلگرام مسدود است، آدرس پروکسی SOCKS را وارد کنید.
# NETWORK_PROXY_URL=socks5://127.0.0.1:1080

# ==========================================
# تنظیمات پایگاه داده
# ==========================================
# نسخه محلی (SQLite پیش‌فرض):
DATABASE_URL=sqlite+aiosqlite:///./rainotek.db

# نسخه سرور چندکاربره (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://rainotek_user:strong_password@localhost:5432/rainotek_db

TZ=Asia/Tehran

# ==========================================
# تنظیمات اتصال به Google Sheets (مستقل)
# ==========================================
# شناسه برگه گوگل (از انتهای آدرس شیت کپی می‌شود):
# مثال: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# مسیر فایل JSON دسترسی سرویس اکانت گوگل (Service Account Credentials):
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# ==========================================
# تنظیمات دستیار صوتی هوش مصنوعی (اختیاری)
# ==========================================
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
SHEET_SYNC_INTERVAL_SECONDS=5
# Signed Apps Script deployment; keep the secret only in local .env.
GOOGLE_SHEET_BRIDGE_URL=
GOOGLE_SHEET_BRIDGE_SECRET=
ADMIN_PHONE_NUMBERS=
